# Maintainer: Steven Persia <persia.steven8@gmail.com>
# Builds the tagged release from source. The release workflow publishes it to
# the AUR with the right version and checksum (packaging/aur/publish.sh).
pkgname=backslash
pkgver=0.4.0
pkgrel=1
pkgdesc="A fast, extensible launcher for Linux"
arch=('x86_64' 'aarch64')
url="https://github.com/backslash-app/backslash"
license=('MIT')
depends=('gtk4' 'git' 'deno')
makedepends=('cargo')
optdepends=(
  'wl-clipboard: clipboard history on Wayland'
  'fd: faster file search'
  'libsecret: keep extension secrets in the keyring'
  'gtk4-layer-shell: overlay window on wlroots compositors'
  'wmctrl: window switcher on X11'
)
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('5226bd024b883b7635aca9872309c25e373a4a75cb8c4508cec397fd1c6a99c2')

prepare() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable CARGO_TARGET_DIR=target
  cargo build --frozen --release
}

check() {
  cd "$pkgname-$pkgver"
  cargo test --frozen -p backslash-core --lib
}

package() {
  cd "$pkgname-$pkgver"
  make install DESTDIR="$pkgdir" PREFIX=/usr
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
