<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>app.backslash.Backslash</id>
  <name>Backslash</name>
  <summary>A fast, extensible launcher</summary>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT</project_license>
  <description>
    <p>
      Press a shortcut, type a few letters, and open an app, compute, convert units and
      currencies, find a file, switch windows or paste from your clipboard history.
    </p>
    <p>
      Extensions are written in TypeScript and run in a sandbox with only the permissions
      they declare. They are installed from a reviewed registry, pinned to the exact code
      that was checked.
    </p>
  </description>
  <launchable type="desktop-id">app.backslash.Backslash.desktop</launchable>
